{
  "name": "gguf-size",
  "version": "0.1.0",
  "description": "GGUF quantization file size (F16 to Q2_K) and VRAM estimate (weights, KV cache, overhead) for local LLMs. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "homepage": "https://nanocalcs.com/en/llm-quantization-size-calculator/",
  "keywords": [
    "gguf",
    "llama.cpp",
    "quantization",
    "vram",
    "llm",
    "kv-cache"
  ],
  "author": "nanocalcs.com",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
