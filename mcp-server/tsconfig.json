{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "paths": { "js-tiktoken/*": ["./node_modules/js-tiktoken/dist/*.d.ts"] }
  },
  "include": ["src", "test", "vite.config.ts"]
}
