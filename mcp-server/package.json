{
  "name": "nanocalcs-mcp",
  "version": "0.2.0",
  "description": "MCP server for nanocalcs.com: exact calculators (dates, business days, Schengen, time zones, loans, compound interest, units, molar mass, SAT/AP scores, LLM tokens, API cost, GPU VRAM) plus prefilled links to 370+ free online tools.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://nanocalcs.com",
  "mcpName": "com.nanocalcs/calculators",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "calculator",
    "tokens",
    "llm",
    "nanocalcs"
  ],
  "bin": {
    "nanocalcs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "js-tiktoken": "1.0.21",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
